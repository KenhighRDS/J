<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="72dp" android:paddingBottom="40dp">
    <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_launcher_foreground" android:contentDescription="@null" />
    <TextView android:id="@+id/kicker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:textColor="#8E8E93" android:textSize="15sp" android:text="@string/alert_new_signal" />
    <TextView android:id="@+id/headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:gravity="center" android:textColor="#F5F5F7" android:textSize="34sp" android:textStyle="bold" android:letterSpacing="-0.02" android:maxLines="2" />
    <TextView android:id="@+id/subline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:textColor="#BFC3C9" android:textSize="16sp" android:maxLines="3" />
    <TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="36dp"
        android:fontFamily="monospace" android:textColor="#F5F5F7" android:textSize="56sp" android:text="2:00" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#8E8E93" android:textSize="13sp" android:text="@string/alert_until_expiry" />
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/open" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center"
        android:background="@drawable/bg_button_chrome" android:textColor="#000000" android:textSize="19sp" android:textStyle="bold" android:text="@string/alert_open" />
    <TextView android:id="@+id/skip" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:gravity="center"
        android:background="@drawable/bg_button_ghost" android:textColor="#F5F5F7" android:textSize="17sp" android:text="@string/alert_skip" />
</LinearLayout>
