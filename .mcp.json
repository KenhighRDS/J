{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "serena": {
      "command": "bash",
      "args": [".claude/mcp/serena.sh"]
    },
    "playwright": {
      "command": "bash",
      "args": [".claude/mcp/playwright.sh"]
    },
    "context-mode": {
      "command": "bash",
      "args": [".claude/mcp/context-mode.sh"]
    }
  }
}
