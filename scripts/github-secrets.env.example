# Copy to scripts/github-secrets.env (gitignored), fill the blanks, then run: bash scripts/github-secrets.sh
# The filled file and the keystore never leave your PC.
REPO=KenhighRDS/J
# Keystore generated on this PC (SETUP.md section 5) and its passwords
ANDROID_KEYSTORE_FILE=./j-release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=j
ANDROID_KEY_PASSWORD=
# Fine-grained GitHub token with Contents: read and write on the releases repo
RELEASES_TOKEN=
RELEASES_REPO=KenhighRDS/j-releases
SITE_URL=https://j-signals.netlify.app
# Public web config (same values as Netlify; the three blanks are gitleaks-sensitive, copy them from Netlify → Environment variables)
